+/--
+Runs a deriving handler. With the Paralean hook `canonicalInstNames`, the instances it names through
+`mkInstName` get canonical names (`Lean.Paralean.canonicalInstanceName` of their final types): the
+handler first runs under the names `mkInstName` proposes, and if an instance's final type gives a
+different name, the state is restored and the handler runs again with those names.
+-/
+private def runDerivingHandler (handler : DerivingHandler) (typeNames : Array Name) :
+    CommandElabM Bool := do
+  unless (← Paralean.getConfig).canonicalInstNames do
+    return (← handler typeNames)
+  let s0 ← get
+  let outerLog ← Paralean.derivedInstNamesRef.swap #[]
+  let outerOverrides ← Paralean.derivedInstNameOverridesRef.get
+  let canonicalNames (recs : Array Paralean.DerivedInstName) :
+      CommandElabM (Array (Paralean.DerivedInstName × Name)) := do
+    let s ← get
+    let mut out := #[]
+    for r in recs do
+      let some ci := Paralean.findDeclaredInstance? (← getEnv) (r.ns ++ r.used) | continue
+      out := out.push (r, ← liftTermElabM <| Paralean.canonicalInstanceName ci.type)
+    set s
+    return out
+  try
+    if !(← handler typeNames) then
+      return false
+    let names ← canonicalNames (← Paralean.derivedInstNamesRef.swap #[])
+    if names.all fun (r, c) => r.used == c then
+      for (r, c) in names do
+        Paralean.logInstName { canonical := r.ns ++ c, stock := r.ns ++ r.stock, passes := 1, derived := true }
+      return true
+    set s0
+    for (r, c) in names do
+      if (Paralean.findDeclaredInstance? (← getEnv) (r.ns ++ c)).isSome then
+        Paralean.throwInstanceNameCollision (← getRef) (r.ns ++ c)
+    Paralean.derivedInstNameOverridesRef.set <|
+      names.foldl (fun m (r, c) => m.insert (r.className, r.indName) c) outerOverrides
+    let ok ← handler typeNames
+    for (r, c) in ← canonicalNames (← Paralean.derivedInstNamesRef.swap #[]) do
+      if r.used != c then
+        throwError "deriving handler named the instance {r.ns ++ r.used}, but its canonical name \
+          is {r.ns ++ c}"
+      Paralean.logInstName { canonical := r.ns ++ c, stock := r.ns ++ r.stock, passes := 2, derived := true }
+    return ok
+  finally
+    Paralean.derivedInstNamesRef.set outerLog
+    Paralean.derivedInstNameOverridesRef.set outerOverrides
+
 def applyDerivingHandlers (className : Name) (typeNames : Array Name) (setExpose := false) : CommandElabM Unit := do
   withScope (fun sc => { sc with
     attrs := if setExpose then Unhygienic.run `(Parser.Term.attrInstance| expose) :: sc.attrs else sc.attrs
@@ -303,7 +358,7 @@ def applyDerivingHandlers (className : Name) (typeNames : Array Name) (setExpose
     match (← derivingHandlersRef.get).find? className with
     | some handlers =>
       for handler in handlers do
-        if (← handler typeNames) then
+        if (← runDerivingHandler handler typeNames) then
           return ()
       throwError "None of the deriving handlers for class `{.ofConstName className}` applied to \
         {.andList <| typeNames.toList.map (m!"`{.ofConstName ·}`")}"
