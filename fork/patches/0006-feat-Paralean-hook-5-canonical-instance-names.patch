@@ -0,0 +1,105 @@
+import Lean
+
+/-!
+Paralean hook 5: with `LEAN_PARALEAN`, instances the elaborator names get canonical names
+`<stock base>_<8 hex of H("v0/insttype", text(type))>` (SHA-256 of `"paralean" NUL "v0/insttype" NUL ‖ PCE(text)`): anonymous `instance`s, deriving
+handlers (`mkInstName`) and delta deriving. Names never take a `_n` suffix; a second instance of
+the same type is a collision.
+-/
+open Lean Elab Command
+
+class Foo (α : Type) where foo : α
+instance : Foo Nat := ⟨0⟩
+instance [Foo α] : Foo (List α) := ⟨[Foo.foo]⟩
+
+-- stock Lean names these `instInhabitedULiftNat_elab` and `instInhabitedULiftNat_elab_1`, by order
+instance : Inhabited (ULift.{1} Nat) := ⟨⟨0⟩⟩
+instance : Inhabited (ULift.{2} Nat) := ⟨⟨1⟩⟩
+
+section
+variable {β : Type} [Foo β]
+-- the section variables are part of the type
+instance : Foo (Option β) := ⟨some Foo.foo⟩
+end
+
+inductive Color where
+  | red | green
+  deriving Repr, BEq, DecidableEq, Hashable, Ord
+
+structure Box (α : Type) where
+  val : α
+  deriving Repr, BEq
+
+def MyNat := Nat
+deriving instance Inhabited for MyNat
+
+/-- The instance names this file declared, sorted. -/
+def instNames : CommandElabM (Array Name) := do
+  let env ← getEnv
+  let names := (Meta.instanceExtension.getState env).instanceNames.toList.map (·.1)
+  return names.filter (fun n => (env.getModuleIdxFor? n).isNone && !n.isInternal) |>.toArray.qsort Name.lt
+
+/--
+info: [instBEqBox_cebe9d10,
+ instBEqColor_66baa0d4,
+ instDecidableEqColor_2b9ec6f5,
+ instFooList_70b5f0bb,
+ instFooNat_c7b916fb,
+ instFooOption_bc12a9e6,
+ instHashableColor_aaa7160b,
+ instInhabitedMyNat_21b31b6f,
+ instInhabitedULiftNat_06ff4481,
+ instInhabitedULiftNat_92742698,
+ instOrdColor_6e5d2c45,
+ instReprBox_4eb02076,
+ instReprColor_1139f21f]
+-/
+#guard_msgs in
+run_cmd logInfo m!"{← instNames}"
+
+-- deriving auxiliaries follow the canonical name
+/--
+info: @[instance_reducible] def instReprColor_1139f21f : Repr Color :=
+{ reprPrec := instReprColor_1139f21f.repr }
+-/
+#guard_msgs in
+#print instReprColor_1139f21f
+
+-- a duplicate instance is a collision, not `instFooNat_c7b916fb_1`
+/-- error: instance name collision: instFooNat_c7b916fb is already declared (a duplicate instance of the same type; canonical instance names never take a `_n` suffix) -/
+#guard_msgs in
+instance : Foo Nat := ⟨1⟩
+
+-- every choice is recorded for the host, with the stock name
+/--
+info: instBEqBox_cebe9d10 stock=instBEqBox passes=2 derived=true
+---
+info: instBEqColor_66baa0d4 stock=instBEqColor passes=2 derived=true
+---
+info: instDecidableEqColor_2b9ec6f5 stock=instDecidableEqColor passes=1 derived=false
+---
+info: instFooList_70b5f0bb stock=instFooList passes=1 derived=false
+---
+info: instFooNat_c7b916fb stock=instFooNat passes=1 derived=false
+---
+info: instFooOption_bc12a9e6 stock=instFooOption passes=1 derived=false
+---
+info: instHashableColor_aaa7160b stock=instHashableColor passes=2 derived=true
+---
+info: instInhabitedMyNat_21b31b6f stock=instInhabitedMyNat passes=1 derived=true
+---
+info: instInhabitedULiftNat_06ff4481 stock=instInhabitedULiftNat_elab passes=1 derived=false
+---
+info: instInhabitedULiftNat_92742698 stock=instInhabitedULiftNat_elab passes=1 derived=false
+---
+info: instOrdColor_6e5d2c45 stock=instOrdColor passes=2 derived=true
+---
+info: instReprBox_4eb02076 stock=instReprBox passes=2 derived=true
+---
+info: instReprColor_1139f21f stock=instReprColor passes=2 derived=true
+-/
+#guard_msgs in
+run_cmd do
+  let log ← Paralean.takeInstNameLog
+  for r in log.qsort (fun a b => a.canonical.lt b.canonical) do
+    logInfo m!"{r.canonical} stock={r.stock} passes={r.passes} derived={r.derived}"
