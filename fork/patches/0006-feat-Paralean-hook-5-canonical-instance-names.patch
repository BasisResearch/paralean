+/--
+Paralean hook 5: elaborates an `instance` without a name under its canonical name
+(`Lean.Paralean.canonicalInstanceName` of its final type). The name predicted from the header is
+used first; if the final type gives a different name, the command is elaborated again under that
+name. Commands whose stock name has macro scopes keep the stock name.
+-/
+private def elabCanonicalInstance (stx : Syntax) : CommandElabM Unit := do
+  let inst := stx[1]
+  let s0 ← get
+  let ns ← getCurrNamespace
+  let binders := inst[4][0].getArgs
+  let type := inst[4][1][1]
+  let stockId ← mkInstanceName binders type
+  if stockId.hasMacroScopes then
+    return (← elabMutualDef #[stx])
+  let predicted? ← Paralean.predictInstanceName binders type
+  let elabWith (id : Name) : CommandElabM Unit := do
+    let declId := mkNode ``Parser.Command.declId #[mkIdentFrom inst[1] id (canonical := true), mkNullNode]
+    elabMutualDef #[stx.setArg 1 (inst.setArg 3 (mkNullNode #[declId]))]
+  let numErrors := fun (s : Command.State) => s.messages.toList.filter (·.severity == .error) |>.length
+  -- first pass under the predicted name (the stock name if there is none or it is taken)
+  let env ← getEnv
+  let first := match predicted? with
+    | some p => if (Paralean.findDeclaredInstance? env (ns ++ p)).isSome then stockId else p
+    | none => stockId
+  elabWith first
+  let s1 ← get
+  if numErrors s1 > numErrors s0 then return
+  let some ci := Paralean.findDeclaredInstance? s1.env (ns ++ first) | return
+  let canon ← liftTermElabM <| Paralean.canonicalInstanceName ci.type
+  set s1
+  if canon == first then
+    Paralean.logInstName { canonical := ns ++ canon, stock := ns ++ stockId, passes := 1, derived := false }
+    return
+  -- second pass under the name of the final type
+  set s0
+  if (Paralean.findDeclaredInstance? (← getEnv) (ns ++ canon)).isSome then
+    Paralean.throwInstanceNameCollision inst[1] (ns ++ canon)
+  elabWith canon
+  Paralean.logInstName { canonical := ns ++ canon, stock := ns ++ stockId, passes := 2, derived := false }
+
 @[builtin_command_elab declaration, builtin_incremental]
 def elabDeclaration : CommandElab := fun stx => do
   withExporting (isExporting := (← getScope).isPublic) do
   let modifiers : TSyntax ``Parser.Command.declModifiers := ⟨stx[0]⟩
   let decl     := stx[1]
   let declKind := decl.getKind
-  if isDefLike decl then
+  if declKind == ``Lean.Parser.Command.instance && decl[3].isNone &&
+      (← Paralean.getConfig).canonicalInstNames then
+    withoutCommandIncrementality true <| elabCanonicalInstance stx
+  else if isDefLike decl then
     -- only case implementing incrementality currently
     elabMutualDef #[stx]
   else withoutCommandIncrementality true do
