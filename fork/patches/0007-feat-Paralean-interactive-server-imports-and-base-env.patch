diff --git a/src/Lean/Paralean/BaseEnv.lean b/src/Lean/Paralean/BaseEnv.lean
new file mode 100644
index 0000000..133b57d
--- /dev/null
+++ b/src/Lean/Paralean/BaseEnv.lean
@@ -0,0 +1,30 @@
+/-
+Copyright (c) 2026 Basis Research Institute. All rights reserved.
+Released under Apache 2.0 license as described in the file LICENSE.
+-/
+module
+
+public import Lean.Environment
+public import Lean.Elab.Command.Scope
+
+public section
+
+namespace Lean.Paralean
+
+/-- The imported environment of the current file worker, before user commands.
+Paralean's capsule elaborator uses this to discard root-level local attributes. -/
+private initialize baseEnvRef : IO.Ref (Option Environment) ← IO.mkRef none
+private initialize baseScopeRef : IO.Ref (Option Elab.Command.Scope) ← IO.mkRef none
+private initialize documentPathRef : IO.Ref (Option String) ← IO.mkRef none
+
+def setBaseEnv (env : Environment) : BaseIO Unit := baseEnvRef.set (some env)
+
+def getBaseEnv : BaseIO (Option Environment) := baseEnvRef.get
+def setBaseScope (scope : Elab.Command.Scope) : BaseIO Unit := baseScopeRef.set (some scope)
+def getBaseScope : BaseIO (Option Elab.Command.Scope) := baseScopeRef.get
+
+/-- Absolute source path of this worker's document (one file per worker process). -/
+def setDocumentPath (path : String) : BaseIO Unit := documentPathRef.set (some path)
+def getDocumentPath : BaseIO (Option String) := documentPathRef.get
+
+end Lean.Paralean
