+/--
+Declarations a `simp` or `simp_all` call used, recorded as a custom info-tree leaf on the tactic
+syntax when the Paralean hook `simpUsed` is active. `rfl` lemmas used by `simp` need not appear in
+the proof term, so this is the only record of them.
+-/
+structure SimpUsedInfo where
+  names : Array Name
+  deriving TypeName
+
+/-- Paralean hook: record the declarations in `used` (if any) as a `SimpUsedInfo` leaf. -/
+def recordSimpUsed (stx : Syntax) (used : Simp.UsedSimps) : TacticM Unit := do
+  unless (← Paralean.getConfig).simpUsed do return
+  let names := used.map.toList.toArray.filterMap fun (o, _) => match o with
+    | .decl n .. => some n
+    | _ => none
+  unless names.isEmpty do
+    pushInfoLeaf <| .ofCustomInfo { stx, value := Dynamic.mk ({ names } : SimpUsedInfo) }
+
 def withSimpDiagnostics (x : TacticM Simp.Diagnostics) : TacticM Unit := do
   let stats ← x
   Simp.reportDiag stats
@@ -796,6 +815,7 @@ def withSimpDiagnostics (x : TacticM Simp.Diagnostics) : TacticM Unit := do
   let stats ← dischargeWrapper.with fun discharge? =>
     withLoopChecking r do
       simpLocation ctx simprocs discharge? (expandOptLocation stx[5])
+  recordSimpUsed stx stats.usedTheorems
   if tactic.simp.trace.get (← getOptions) then
     traceSimpCall stx stats.usedTheorems
   else if Linter.getLinterValue linter.unusedSimpArgs (← Linter.getLinterOptions) then
@@ -814,6 +834,7 @@ def withSimpDiagnostics (x : TacticM Simp.Diagnostics) : TacticM Unit := do
   match result? with
   | none => replaceMainGoal []
   | some mvarId => replaceMainGoal [mvarId]
+  recordSimpUsed stx stats.usedTheorems
   if tactic.simp.trace.get (← getOptions) then
     traceSimpCall stx stats.usedTheorems
   else if Linter.getLinterValue linter.unusedSimpArgs (← Linter.getLinterOptions) then
diff --git a/tests/elab/paraleanSimp.lean b/tests/elab/paraleanSimp.lean
new file mode 100644
index 0000000..e50868f
--- /dev/null
+++ b/tests/elab/paraleanSimp.lean
@@ -0,0 +1,40 @@
+import Lean
+
+/-!
+Paralean hook 4: with `LEAN_PARALEAN`, `simp` and `simp_all` record the declarations they used as a
+`SimpUsedInfo` info leaf, including `rfl` lemmas that do not appear in the proof term.
+-/
+open Lean Elab Command
+
+def f (n : Nat) : Nat := n + 0
+@[simp] theorem f_eq (n : Nat) : f n = n := rfl
+
+/-- `#simpUsed cmd` elaborates `cmd` and prints the `SimpUsedInfo` leaves of its info trees. -/
+elab "#simpUsed " cmd:command : command => do
+  let trees₀ := (← get).infoState.trees.size
+  elabCommand cmd
+  let trees := (← get).infoState.trees.toArray.extract trees₀
+  for t in trees do
+    t.visitM' (postNode := fun _ i _ => do
+      if let .ofCustomInfo ci := i then
+        if let some u := ci.value.get? Lean.Elab.Tactic.SimpUsedInfo then
+          logInfo m!"{u.names.qsort Name.lt}")
+
+/-- info: [eq_self, f_eq] -/
+#guard_msgs in
+#simpUsed theorem t1 (n : Nat) : f n = n := by simp
+
+/-- info: [eq_self, f_eq] -/
+#guard_msgs in
+#simpUsed theorem t2 (n : Nat) (h : f n = 3) : n = 3 := by simp_all
+
+/-- info: [eq_self, f, Nat.add_zero] -/
+#guard_msgs in
+#simpUsed theorem t3 (n : Nat) : f n = n := by simp only [f, Nat.add_zero]
+
+-- `f_eq` is proved by `rfl`, so it does not appear in the proof term of `t1`
+/-- info: false -/
+#guard_msgs in
+#eval return (match (← getEnv).find? `t1 with
+  | some (.thmInfo v) => v.value.getUsedConstants.contains `f_eq
+  | _ => true)
